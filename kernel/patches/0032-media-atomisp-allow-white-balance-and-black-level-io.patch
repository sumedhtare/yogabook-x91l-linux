From c1711d7ccf7e5e66abd05a09682ea80257041581 Mon Sep 17 00:00:00 2001
From: build <build@local>
Date: Wed, 30 Sep 2026 15:55:54 +0530
Subject: [PATCH 32/32] media: atomisp: allow white balance and black level
 ioctls

---
 drivers/staging/media/atomisp/pci/atomisp_ioctl.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/drivers/staging/media/atomisp/pci/atomisp_ioctl.c b/drivers/staging/media/atomisp/pci/atomisp_ioctl.c
index aa6d13a4d..8d0de1640 100644
--- a/drivers/staging/media/atomisp/pci/atomisp_ioctl.c
+++ b/drivers/staging/media/atomisp/pci/atomisp_ioctl.c
@@ -1370,9 +1370,20 @@ static int atomisp_s_parm(struct file *file, void *fh,
 static long atomisp_vidioc_default(struct file *file, void *fh,
 				   bool valid_prio, unsigned int cmd, void *arg)
 {
-	/* Disable all private IOCTLs for now! */
-	if (cmd)
+	/*
+	 * Disable all private IOCTLs for now, except the fixed-size white
+	 * balance and black level ones: without them userspace has no way to
+	 * white balance the Bayer data and images come out green.
+	 */
+	switch (cmd) {
+	case ATOMISP_IOC_G_ISP_WHITE_BALANCE:
+	case ATOMISP_IOC_S_ISP_WHITE_BALANCE:
+	case ATOMISP_IOC_G_BLACK_LEVEL_COMP:
+	case ATOMISP_IOC_S_BLACK_LEVEL_COMP:
+		break;
+	default:
 		return -EINVAL;
+	}
 
 	struct video_device *vdev = video_devdata(file);
 	struct atomisp_sub_device *asd = atomisp_to_video_pipe(vdev)->asd;
