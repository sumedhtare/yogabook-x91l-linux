#!/bin/sh
# "Living Room" Wayland session (see /usr/share/wayland-sessions/livingroom.desktop):
# sway in kiosk mode (/etc/livingroom/sway.conf) runs livingroom-kiosk; windows
# opened later (AirPlay or DLNA video) go full screen on top of the dashboard,
# which comes back when they close.
exec sway -c /etc/livingroom/sway.conf
