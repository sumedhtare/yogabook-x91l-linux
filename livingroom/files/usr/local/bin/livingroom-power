#!/usr/bin/python3
# Screen power for the living-room display (runs in the kiosk session).
#
# Settings: the "Screen power" part of /etc/livingroom.conf (re-read when the
# file changes). In short:
#   screen = auto          auto: sleep after `sleep_after` minutes without
#                          touch; on: never sleep; sleep: dark unless woken
#   sleep_after = 10
#   wake_on = camera light what wakes the screen besides touch (or: none)
#   schedule = mon-fri 23:00-07:00 sleep          several lines allowed;
#   schedule = sat,sun 09:00-22:00 on             the last matching one wins
#   schedule = daily 00:00-06:00 sleep wake_on=camera
#
# Also: screen brightness (auto from the ambient light sensors, or fixed)
# and keeping the keyboard backlight off.
#   brightness = auto      or a percentage
#   brightness_min = 5     brightness_max = 100   (the auto range, %)
#   keyboard_light = off   off: kept off; on: left to the keyboard driver
#
# The screen never sleeps while another device is connected: a Bluetooth
# device, an AirPlay/DLNA sender with an open connection, or a cast on screen
# (AirPlay/DLNA video, a shared laptop screen).
#
# Touch is seen through swayidle (ext-idle-notify); the screen is switched
# with sway's "output * power off|on" (the panel and backlight go off and
# nothing is drawn, so the dashboard costs no CPU while dark).
# Camera motion: yogabook-capture --motion (root, through sudoers), only
# while the screen is dark. Light: the ambient light sensors (iio "als").
import datetime
import glob
import json
import os
import re
import socket
import struct
import subprocess
import sys
import threading
import time

CONF = os.environ.get("LIVINGROOM_CONF", "/etc/livingroom.conf")
# Written by the dashboard's Screen panel; replaces screen/sleep_after/
# wake_on/schedules from CONF. The status file tells the panel what is in
# effect.
OVERRIDE = os.path.expanduser("~/.config/livingroom/power.json")
STATUS = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "livingroom-power.json")
DASHBOARD_APP_ID = "local.livingroom"
DAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
GRACE = 6          # s after the screen goes dark before sensors count


def log(msg):
    print(f"{time.strftime('%H:%M:%S')} livingroom-power: {msg}", file=sys.stderr, flush=True)


# ---------------------------------------------------------------- settings

def parse_days(spec):
    spec = spec.lower()
    named = {"daily": DAYS, "everyday": DAYS, "weekdays": DAYS[:5], "weekends": DAYS[5:]}
    if spec in named:
        return {DAYS.index(d) for d in named[spec]}
    out = set()
    for part in spec.split(","):
        if "-" in part:
            a, b = (DAYS.index(x[:3]) for x in part.split("-"))
            i = a
            while True:
                out.add(i)
                if i == b:
                    break
                i = (i + 1) % 7
        else:
            out.add(DAYS.index(part[:3]))
    return out


def parse_wake(v):
    v = v.replace(",", " ").split()
    return {x for x in v if x in ("camera", "light")}


def hm(s):
    h, m = s.split(":")
    return int(h) * 60 + int(m)


class Settings:
    def __init__(self):
        self.mtimes = None
        self.load()

    @staticmethod
    def stamp():
        out = []
        for f in (CONF, OVERRIDE):
            try:
                out.append(os.path.getmtime(f))
            except OSError:
                out.append(None)
        return out

    def load(self):
        c = {"screen": "auto", "sleep_after": "10", "wake_on": "camera light",
             "brightness": "auto", "brightness_min": "5", "brightness_max": "100",
             "keyboard_light": "off",
             "camera": "front", "camera_sensitivity": "3", "light_sensitivity": "30"}
        schedules = []
        try:
            with open(CONF) as f:
                for n, line in enumerate(f, 1):
                    line = line.split("#", 1)[0].strip()
                    if "=" not in line:
                        continue
                    k, v = (x.strip() for x in line.split("=", 1))
                    if k == "schedule":
                        try:
                            schedules.append(self.schedule(v))
                        except (ValueError, IndexError) as e:
                            log(f"{CONF}:{n}: bad schedule {v!r} ({e})")
                    else:
                        c[k] = v
        except OSError:
            pass
        self.mtimes = self.stamp()
        self.source = "file"
        try:
            with open(OVERRIDE) as f:
                o = json.load(f)
            c["screen"] = str(o.get("screen", c["screen"]))
            c["sleep_after"] = str(o.get("sleep_after", c["sleep_after"]))
            c["brightness"] = str(o.get("brightness", c["brightness"]))
            c["keyboard_light"] = str(o.get("keyboard_light", c["keyboard_light"]))
            c["wake_on"] = " ".join(o.get("wake_on", [])) or "none"
            schedules = []
            for sc in o.get("schedules", []):
                w = sc.get("wake_on")
                schedules.append(({int(d) % 7 for d in sc["days"]}, hm(sc["start"]), hm(sc["end"]),
                                  sc["mode"] if sc["mode"] in ("on", "auto", "sleep") else "auto",
                                  None if w is None else set(w) & {"camera", "light"}))
            self.source = "screen"
        except FileNotFoundError:
            pass
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
            log(f"{OVERRIDE}: ignored ({e})")
        self.default = c["screen"] if c["screen"] in ("auto", "on", "sleep") else "auto"
        try:
            self.sleep_after = max(0.5, float(c["sleep_after"])) * 60
        except ValueError:
            self.sleep_after = 600
        if c["sleep_after"].strip() in ("0", "never"):
            self.default = "on"
        self.wake_on = parse_wake(c["wake_on"])
        self.camera = c["camera"] if c["camera"] in ("front", "rear") else "front"
        self.cam_level = float(c["camera_sensitivity"]) / 100
        self.light_level = float(c["light_sensitivity"]) / 100
        b = c["brightness"].strip().rstrip("%")
        self.brightness = None if b == "auto" else max(1, min(100, float(b)))   # None = auto
        self.b_min = max(1, min(100, float(c["brightness_min"])))
        self.b_max = max(self.b_min, min(100, float(c["brightness_max"])))
        self.kbd_off = c["keyboard_light"].strip().lower() != "on"
        self.schedules = schedules
        log(f"settings ({self.source}): screen={self.default} sleep_after={self.sleep_after / 60:g}min "
            f"wake_on={','.join(sorted(self.wake_on)) or 'none'} schedules={len(schedules)}")

    @staticmethod
    def schedule(v):
        # <days> <HH:MM>-<HH:MM> <on|auto|sleep> [wake_on=camera,light|none]
        parts = v.split()
        days = parse_days(parts[0])
        start, end = (hm(x) for x in parts[1].split("-"))
        mode = parts[2].lower()
        if mode not in ("on", "auto", "sleep"):
            raise ValueError(f"mode must be on, auto or sleep, not {mode}")
        wake = None                   # None = the global wake_on
        for p in parts[3:]:
            if p.startswith("wake_on="):
                wake = parse_wake(p.split("=", 1)[1])
        return days, start, end, mode, wake

    def maybe_reload(self):
        if self.stamp() != self.mtimes:
            self.load()

    def export(self):
        """The settings in the Screen panel's format."""
        t = lambda m: f"{m // 60:02d}:{m % 60:02d}"
        return {"screen": self.default, "sleep_after": round(self.sleep_after / 60, 1),
                "wake_on": sorted(self.wake_on), "source": self.source,
                "brightness": "auto" if self.brightness is None else round(self.brightness),
                "keyboard_light": "off" if self.kbd_off else "on",
                "schedules": [{"days": sorted(d), "start": t(a), "end": t(b), "mode": m,
                               "wake_on": None if w is None else sorted(w)}
                              for d, a, b, m, w in self.schedules]}

    def now_mode(self):
        """(mode, wake sensors) for this moment."""
        t = datetime.datetime.now()
        day, minute = t.weekday(), t.hour * 60 + t.minute
        mode, wake, scheduled = self.default, None, False
        for days, start, end, m, w in self.schedules:
            if start < end:
                hit = day in days and start <= minute < end
            else:                     # past midnight: belongs to the start day
                hit = (day in days and minute >= start) or ((day - 1) % 7 in days and minute < end)
            if hit:
                mode, wake, scheduled = m, w, True
        if wake is None:
            # a "sleep" schedule wakes by touch only unless it says wake_on=
            wake = set() if scheduled and mode == "sleep" else self.wake_on
        return mode, wake


# ---------------------------------------------------------------- sway

class Sway:
    def __init__(self):
        self.path = os.environ.get("SWAYSOCK")
        if not self.path:
            self.path = (glob.glob(f"/run/user/{os.getuid()}/sway-ipc.*.sock") or [None])[0]

    def ipc(self, kind, payload=""):
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(5)
        s.connect(self.path)
        data = payload.encode()
        s.sendall(b"i3-ipc" + struct.pack("<II", len(data), kind) + data)
        head = b""
        while len(head) < 14:
            head += s.recv(14 - len(head))
        n = struct.unpack("<I", head[6:10])[0]
        body = b""
        while len(body) < n:
            body += s.recv(n - len(body))
        s.close()
        return json.loads(body)

    def power(self, on):
        self.ipc(0, f"output * power {'on' if on else 'off'}")

    def is_on(self):
        return all(o.get("power", True) for o in self.ipc(3))

    def casts(self):
        """Windows other than the dashboard (AirPlay, DLNA, laptop screen)."""
        found = []

        def walk(n):
            if n.get("pid") and n.get("app_id") != DASHBOARD_APP_ID:
                found.append(n.get("app_id") or n.get("name") or "window")
            for c in n.get("nodes", []) + n.get("floating_nodes", []):
                walk(c)
        walk(self.ipc(4))
        return found


# ---------------------------------------------------------------- connected devices

def bluetooth_connected():
    try:
        import dbus
        om = dbus.Interface(dbus.SystemBus().get_object("org.bluez", "/"),
                            "org.freedesktop.DBus.ObjectManager")
        # not speakers/headphones (major class audio/video): the room's own
        # output speaker (bluetooth_speaker) stays connected all the time
        return [str(i["org.bluez.Device1"].get("Alias", "?"))
                for i in om.GetManagedObjects().values()
                if i.get("org.bluez.Device1", {}).get("Connected")
                and (int(i["org.bluez.Device1"].get("Class", 0)) >> 8) & 0x1f != 0x04]
    except Exception:
        return []


def receivers_connected():
    """Receivers (uxplay, gmediarender) with an established TCP connection:
    an AirPlay sender connected, or a DLNA stream being fetched."""
    established = set()
    for f in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(f) as fh:
                next(fh)
                for line in fh:
                    p = line.split()
                    local, remote = p[1].split(":")[0], p[2].split(":")[0]
                    # not to this machine itself (the dashboard polls
                    # gmediarender over the LAN address)
                    if p[3] == "01" and remote != local and not remote.startswith(
                            ("0100007F", "0000000000000000FFFF00000100007F",
                             "00000000000000000000000001000000")):
                        established.add(p[9])      # socket inode
        except OSError:
            pass
    busy = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/comm") as f:
                comm = f.read().strip()
            if comm not in ("uxplay", "gmediarender"):
                continue
            for fd in os.listdir(f"/proc/{pid}/fd"):
                m = re.match(r"socket:\[(\d+)\]", os.readlink(f"/proc/{pid}/fd/{fd}"))
                if m and m.group(1) in established:
                    busy.append(comm)
                    break
        except OSError:
            pass
    return busy


# ---------------------------------------------------------------- inputs

class Touch(threading.Thread):
    """Last user input, from swayidle (1 s idle timeout -> "idle", any input
    after that -> "active")."""

    def __init__(self):
        super().__init__(daemon=True)
        self.active = True
        self.last = time.time()

    def run(self):
        while True:
            p = subprocess.Popen(["swayidle", "-w", "timeout", "1", "echo idle",
                                  "resume", "echo active"],
                                 stdout=subprocess.PIPE, text=True)
            for line in p.stdout:
                self.last = time.time()
                self.active = line.strip() == "active"
            log("swayidle exited; restarting")
            time.sleep(5)

    def last_input(self):
        return time.time() if self.active else self.last - 1


class Light:
    """Ambient light sensors: a jump away from the recent average (lights
    switched on, someone walking past close by)."""

    def __init__(self):
        self.devs = [d for d in glob.glob("/sys/bus/iio/devices/iio:device*")
                     if open(f"{d}/name").read().strip() == "als"]
        self.base = {}

    def read(self, d):
        with open(f"{d}/in_illuminance_raw") as f:
            raw = float(f.read())
        with open(f"{d}/in_illuminance_scale") as f:
            return raw * float(f.read())

    def reset(self):
        self.base = {}

    def lux(self):
        vals = []
        for d in self.devs:
            try:
                vals.append(self.read(d))
            except (OSError, ValueError):
                pass
        return max(vals) if vals else None

    def changed(self, level):
        hit = None
        for d in self.devs:
            try:
                lux = self.read(d)
            except (OSError, ValueError):
                continue
            b = self.base.get(d)
            if b is None:
                self.base[d] = lux
                continue
            if abs(lux - b) > max(level * b, 3):
                hit = f"light {b:.0f} -> {lux:.0f} lux"
                self.base[d] = lux
            else:
                self.base[d] = b * 0.9 + lux * 0.1
        return hit


class Camera:
    """Motion from the camera while the screen is dark."""

    def __init__(self):
        self.proc = None
        self.hit = None
        self.failed_at = 0

    def start(self, cam, level):
        if self.proc or time.time() - self.failed_at < 60:
            return
        self.level = level
        self.hit = None
        self.proc = subprocess.Popen(["sudo", "-n", "/usr/local/bin/yogabook-capture", cam, "--motion"],
                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        threading.Thread(target=self.read, args=(self.proc,), daemon=True).start()
        log(f"camera ({cam}) watching for motion")

    def read(self, proc):
        n = 0
        for line in proc.stdout:
            n += 1
            try:
                f = float(line.split()[1])
            except (IndexError, ValueError):
                continue
            if f > self.level:
                self.hit = f"camera motion {f * 100:.1f}%"
        if proc.wait() != 0 and n == 0 and proc is self.proc:
            log("camera did not start (in use by an app?); retrying in a minute")
            self.failed_at = time.time()
            self.proc = None

    def stop(self):
        if self.proc:
            self.proc.terminate()
            try:
                self.proc.wait(5)
            except subprocess.TimeoutExpired:
                self.proc.kill()
            self.proc = None
            log("camera off")

    def take(self):
        h, self.hit = self.hit, None
        return h


class Brightness:
    """Backlight and keyboard light through logind (the session may set its
    own seat's backlight and LEDs without root).

    Auto: ambient light -> brightness on a log scale (eyes see light that way),
    averaged over ~20 s so sensor noise (~4 %) never moves it, changed only
    when the target is 6 points away, and faded over ~2 s. A big jump in room
    light (lamp on/off) is followed at once."""
    BL = "intel_backlight"
    KBD = "ybwmi::kbd_backlight"
    FULL_LUX = 300           # a bright room -> brightness_max

    def __init__(self, light):
        self.light = light
        self.session = None
        self.avg = None
        self.lux = None
        self.target = None
        try:
            with open(f"/sys/class/backlight/{self.BL}/max_brightness") as f:
                self.max = int(f.read())
        except OSError:
            self.max = None
        self.fading = None

    def logind(self):
        if self.session is None:
            import dbus
            bus = dbus.SystemBus()
            self.session = dbus.Interface(
                bus.get_object("org.freedesktop.login1", "/org/freedesktop/login1/session/auto"),
                "org.freedesktop.login1.Session")
        return self.session

    def current(self):
        with open(f"/sys/class/backlight/{self.BL}/brightness") as f:
            return int(f.read()) * 100 / self.max

    def set_raw(self, subsystem, name, value):
        try:
            self.logind().SetBrightness(subsystem, name, int(value))
        except Exception as e:
            self.session = None
            log(f"brightness: {e}")

    def fade(self, pct):
        pct = max(1, min(100, pct))
        self.target = pct
        if self.fading and self.fading.is_alive():
            return                    # the running fade picks up the new target

        def run():
            while True:
                cur = self.current()
                goal = self.target
                if abs(goal - cur) < 1:
                    return
                step = max(1, abs(goal - cur) / 10)
                nxt = cur + step if goal > cur else cur - step
                self.set_raw("backlight", self.BL, round(nxt * self.max / 100))
                time.sleep(0.2)
        self.fading = threading.Thread(target=run, daemon=True)
        self.fading.start()

    def update(self, cfg):
        if self.max is None:
            return
        if cfg.brightness is not None:          # fixed
            if self.target != cfg.brightness:
                self.fade(cfg.brightness)
            return
        lux = self.light.lux()
        if lux is None:
            return
        self.lux = lux
        if self.avg is None or lux > self.avg * 3 + 5 or lux < self.avg / 3 - 5:
            self.avg = lux                      # lights switched on/off
        else:
            self.avg = self.avg * 0.95 + lux * 0.05
        import math
        f = min(1.0, math.log10(self.avg + 1) / math.log10(self.FULL_LUX + 1))
        want = cfg.b_min + (cfg.b_max - cfg.b_min) * f
        if self.target is None or abs(want - self.target) >= 6 or \
                (want in (cfg.b_min, cfg.b_max) and abs(want - self.target) >= 1):
            self.fade(want)

    def keyboard(self, cfg):
        if not cfg.kbd_off:
            return
        try:
            with open(f"/sys/class/leds/{self.KBD}/brightness") as f:
                if int(f.read()) == 0:
                    return
        except OSError:
            return
        self.set_raw("leds", self.KBD, 0)


# ---------------------------------------------------------------- main loop

def main():
    cfg = Settings()
    sway = Sway()
    touch = Touch()
    touch.start()
    light, camera = Light(), Camera()
    bright = Brightness(light)
    screen_on = True
    sway.power(True)
    last_wake = time.time()           # touch/sensor/connection/mode change
    dark_since = 0
    mode_prev = None
    last_status = None
    tick = 0
    while True:
        tick += 1
        cfg.maybe_reload()
        now = time.time()
        mode, wake = cfg.now_mode()
        if mode != mode_prev:
            log(f"mode: {mode} (wake on: {','.join(sorted(wake)) or 'touch only'})")
            if mode_prev is not None and screen_on:
                last_wake = now       # e.g. "on" ended: the idle timer starts now
            if mode == "sleep":
                last_wake = 0         # go dark now
            mode_prev = mode

        # connected devices (every 2 s; cheap enough)
        busy = []
        if tick % 2 == 0 or not screen_on:
            try:
                busy = sway.casts()
            except OSError:
                pass
            busy += receivers_connected() + bluetooth_connected()
            if busy:
                last_wake = now

        last_wake = max(last_wake, touch.last_input())

        if not screen_on and now - dark_since > GRACE:
            why = None
            if "light" in wake:
                why = light.changed(cfg.light_level)
            if "camera" in wake:
                camera.start(cfg.camera, cfg.cam_level)
                why = why or camera.take()
            else:
                camera.stop()
            if why:
                log(f"wake: {why}")
                last_wake = now

        want_on = mode == "on" or bool(busy) or now - last_wake < cfg.sleep_after
        if busy or tick % 2 == 0:
            status = json.dumps({"settings": cfg.export(), "mode": mode, "wake": sorted(wake),
                                 "busy": busy, "screen_on": want_on,
                                 "brightness_now": None if bright.target is None else round(bright.target),
                                 "lux": None if bright.lux is None else round(bright.lux),
                                 "sleep_in": None if want_on is False or mode == "on" or busy
                                 else max(0, round(cfg.sleep_after - (now - last_wake)))})
            if status != last_status:
                last_status = status
                try:
                    with open(STATUS + ".tmp", "w") as f:
                        f.write(status)
                    os.replace(STATUS + ".tmp", STATUS)
                except OSError:
                    pass
        if screen_on:
            bright.update(cfg)
        if tick % 3 == 0:
            bright.keyboard(cfg)
        if want_on != screen_on:
            try:
                sway.power(want_on)
                screen_on = want_on
            except OSError as e:
                log(f"sway: {e}")
            if screen_on:
                camera.stop()
                bright.target = None      # re-apply: the driver restores its own level
                log("screen on" + (f" ({', '.join(busy)} connected)" if busy else ""))
            else:
                dark_since = now
                light.reset()
                log("screen off")
        time.sleep(1)


if __name__ == "__main__":
    sys.exit(main())
