#!/usr/bin/python3
# Share this laptop's screen (and sound) to the living-room display.
#
#   livingroom-share [--extend]            start (Ctrl-C to stop)
#   livingroom-share [--extend] --toggle   start in the background, or stop
#   livingroom-share --stop
#
# Default: mirror a screen or window (GNOME asks which, once).
# --extend: the living-room display becomes an extra 1920x1200 monitor (a
# GNOME virtual monitor) - drag windows onto it with the laptop's mouse.
#
# The screen is captured through the desktop portal (GNOME asks once which
# screen/window to share and remembers it), encoded to H.264 on the Intel
# iGPU (VA-API, falls back to x264) at 1920x1200, and sent with the laptop's
# audio as RTP over UDP to the tablet's livingroom-screen-rx.
import os
import signal
import socket
import subprocess
import sys

CACHE = os.path.expanduser("~/.cache/livingroom-share")
os.makedirs(CACHE, exist_ok=True)
# The VA plugin probes the NVIDIA GPU first on hybrid laptops and registers no
# encoders; point libva at the Intel driver and use a private registry.
os.environ.setdefault("LIBVA_DRIVER_NAME", "iHD")
os.environ.setdefault("GST_REGISTRY", os.path.join(CACHE, "gst-registry.bin"))

import dbus  # noqa: E402
import dbus.mainloop.glib  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gst", "1.0")
from gi.repository import GLib, Gst  # noqa: E402

HOST = os.environ.get("LIVINGROOM_HOST", "sumedh-X91L.local")
VIDEO_PORT, AUDIO_PORT = 5600, 5602
WIDTH, HEIGHT, FPS = 1920, 1200, 30
PIDFILE = os.path.join(CACHE, "pid")
EXTEND = "--extend" in sys.argv
TOKEN = os.path.join(CACHE, "restore-token" + ("-extend" if EXTEND else ""))
PORTAL = "org.freedesktop.portal.Desktop"
PORTAL_PATH = "/org/freedesktop/portal/desktop"


def log(msg):
    print(f"livingroom-share: {msg}", flush=True)


def notify(msg):
    subprocess.run(["notify-send", "-a", "Living Room", "-i", "video-display", "Living Room", msg],
                   check=False, stderr=subprocess.DEVNULL)


class ScreenCast:
    """Minimal xdg-desktop-portal ScreenCast client."""

    def __init__(self, bus, on_ready):
        self.bus, self.on_ready = bus, on_ready
        self.portal = bus.get_object(PORTAL, PORTAL_PATH)
        self.sc = dbus.Interface(self.portal, "org.freedesktop.portal.ScreenCast")
        self.sender = bus.get_unique_name()[1:].replace(".", "_")
        self.n = 0
        self.session = None

    def request(self, method, *args, options=None, then=None):
        self.n += 1
        token = f"lrshare{os.getpid()}_{self.n}"
        path = f"{PORTAL_PATH}/request/{self.sender}/{token}"
        options = dict(options or {}, handle_token=token)

        def response(code, results):
            if code != 0:
                log(f"{method} cancelled/failed ({code})")
                notify("Screen sharing was cancelled")
                GLib.idle_add(loop.quit)
                return
            then(results)

        self.bus.add_signal_receiver(response, "Response", "org.freedesktop.portal.Request",
                                     PORTAL, path)
        getattr(self.sc, method)(*args, options)

    def start(self):
        self.request("CreateSession",
                     options={"session_handle_token": f"lrsession{os.getpid()}"},
                     then=self.created)

    def created(self, results):
        self.session = results["session_handle"]
        # 4 = virtual monitor (extend the desktop); 1|2 = a monitor or a window
        opts = {"types": dbus.UInt32(4 if EXTEND else 1 | 2), "cursor_mode": dbus.UInt32(2),
                "persist_mode": dbus.UInt32(2), "multiple": False}
        try:
            with open(TOKEN) as f:
                opts["restore_token"] = f.read().strip()
        except OSError:
            pass
        self.request("SelectSources", self.session, options=opts, then=self.selected)

    def selected(self, results):
        self.request("Start", self.session, "", then=self.started)

    def started(self, results):
        if "restore_token" in results:
            with open(TOKEN, "w") as f:
                f.write(str(results["restore_token"]))
        node = int(results["streams"][0][0])
        fd = self.sc.OpenPipeWireRemote(self.session, dbus.Dictionary({}, signature="sv")).take()
        self.on_ready(fd, node)

    def close(self):
        if self.session:
            try:
                dbus.Interface(self.bus.get_object(PORTAL, self.session),
                               "org.freedesktop.portal.Session").Close()
            except dbus.DBusException:
                pass


def encoder():
    Gst.init(None)
    for e in ("vah264lpenc", "vah264enc"):
        if Gst.ElementFactory.find(e):
            return f"{e} bitrate=8000 key-int-max={FPS} rate-control=cbr target-usage=7"
    return (f"x264enc tune=zerolatency speed-preset=ultrafast bitrate=8000 key-int-max={FPS}")


def build_pipeline(src):
    host = socket.gethostbyname(HOST)
    enc = encoder()
    log(f"sending to {HOST} ({host}) with {enc.split()[0]}")
    # GNOME sends a new frame only when something changed; keepalive-time
    # makes pipewiresrc repeat the last one twice a second on a still screen
    # (so the receiver never times out), and videorate evens it out to 30 fps.
    # (A compositor "canvas" for a steady rate discarded the late-arriving
    # screen frames and froze the picture.)
    video = (f"pipewiresrc name=cap {src} do-timestamp=true keepalive-time=500 "
             f"! videoconvert ! videoscale add-borders=true "
             f"! video/x-raw,width={WIDTH},height={HEIGHT},pixel-aspect-ratio=1/1 "
             f"! videorate ! video/x-raw,framerate={FPS}/1 "
             f"! queue leaky=downstream max-size-buffers=2 ! videoconvert "
             f"! {enc} ! h264parse config-interval=-1 "
             f"! rtph264pay pt=96 config-interval=-1 mtu=1200 "
             f"! udpsink host={host} port={VIDEO_PORT} sync=false")
    # what the laptop is playing (the default output's monitor)
    audio = (f" pulsesrc device=@DEFAULT_MONITOR@ ! audioconvert ! audioresample "
             f"! audio/x-raw,rate=48000,channels=2 ! opusenc bitrate=128000 "
             f"! rtpopuspay pt=97 ! udpsink host={host} port={AUDIO_PORT} sync=false")
    return Gst.parse_launch(video + audio)


class MonitorRecording:
    """Records one monitor through Mutter's own ScreenCast API.

    The portal's virtual-monitor stream (GNOME 50) only ever contains the
    wallpaper - windows moved onto the virtual monitor are missing - while
    recording that monitor like any other one shows everything. So in extend
    mode the portal stream only keeps the virtual monitor alive, and the
    picture comes from here."""
    N = "org.gnome.Mutter.ScreenCast"

    def __init__(self, connector, on_node, on_closed):
        from gi.repository import Gio
        self.connector = connector
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.session, = self.call("/org/gnome/Mutter/ScreenCast", self.N, "CreateSession",
                                  GLib.Variant("(a{sv})", ({},)))
        # cursor-mode 1 = embedded in the picture
        stream, = self.call(self.session, self.N + ".Session", "RecordMonitor",
                            GLib.Variant("(sa{sv})", (connector, {"cursor-mode": GLib.Variant("u", 1)})))
        self.bus.signal_subscribe(self.N, self.N + ".Stream", "PipeWireStreamAdded", stream,
                                  None, 0, lambda *a: on_node(a[5].unpack()[0]))
        # GNOME ends monitor recordings whenever the display layout changes
        # (a monitor plugged in or out, the virtual one being placed)
        self.bus.signal_subscribe(self.N, self.N + ".Session", "Closed", self.session,
                                  None, 0, lambda *a: on_closed(self))
        self.call(self.session, self.N + ".Session", "Start", None)

    def call(self, path, iface, method, args):
        return self.bus.call_sync(self.N, path, iface, method, args, None, 0, -1, None).unpack()

    def stop(self):
        try:
            self.call(self.session, self.N + ".Session", "Stop", None)
        except GLib.Error:
            pass


def virtual_monitors():
    from gi.repository import Gio
    N, P = "org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig"
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    _s, monitors, _l, _p = bus.call_sync(N, P, N, "GetCurrentState", None, None, 0, -1, None).unpack()
    return {m[0][0] for m in monitors if m[0][0].startswith("Meta-")}


def place_virtual_monitor(before, found, tries=[0]):
    """GNOME creates the virtual monitor ("Meta-N") but does not add it to the
    desktop layout, so the pointer and windows cannot reach it. Put it to the
    right of the existing monitors (temporary config: not saved)."""
    from gi.repository import Gio
    N, P = "org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig"
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)

    def call(m, a=None):
        return bus.call_sync(N, P, N, m, a, None, 0, -1, None).unpack()

    try:
        serial, monitors, logical, _ = call("GetCurrentState")
        mode = {}
        for spec, modes, _props in monitors:
            m = ([x for x in modes if x[6].get("is-current")]
                 or [x for x in modes if x[6].get("is-preferred")] or modes)
            mode[spec[0]] = m[0]
        new = sorted(c for c in mode if c.startswith("Meta-") and c not in before)
        if not new:
            tries[0] += 1
            if tries[0] >= 20:            # ~10 s
                log("the virtual monitor did not appear")
                GLib.idle_add(loop.quit)
                return False
            return True
        placed = {lm[5][0][0] for lm in logical}
        virtual = [c for c in new if c not in placed]
        if not virtual:                   # GNOME remembered where it goes
            found(new[-1])
            return False
        cfg, right = [], 0
        for x, y, scale, transform, primary, specs, _p in logical:
            conn = specs[0][0]
            cfg.append((x, y, scale, transform, primary, [(conn, mode[conn][0], {})]))
            right = max(right, x + round(mode[conn][1] / scale))
        cfg.append((right, 0, 1.0, 0, False, [(virtual[0], mode[virtual[0]][0], {})]))
        call("ApplyMonitorsConfig",
             GLib.Variant("(uua(iiduba(ssa{sv}))a{sv})", (serial, 1, cfg, {})))
        log(f"extra monitor {virtual[0]} placed right of the others (x={right})")
        GLib.timeout_add(1000, lambda: found(virtual[0]) and False)
    except Exception as e:
        log(f"could not place the virtual monitor: {e}")
    return False


def running_pid():
    try:
        with open(PIDFILE) as f:
            pid = int(f.read())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def main():
    args = [a for a in sys.argv[1:] if a != "--extend"]
    arg = args[0] if args else ""
    pid = running_pid()
    if arg in ("--stop", "--toggle") and pid:
        os.kill(pid, signal.SIGTERM)
        notify("Stopped sharing to the living room")
        return 0
    if arg == "--stop":
        return 0
    if pid:
        log(f"already running (pid {pid})")
        return 1
    if arg == "--toggle" and os.fork():
        return 0          # parent returns; child keeps running in the background

    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    global loop
    Gst.init(None)
    loop = GLib.MainLoop()
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    state = {}

    def stream(src):
        pipe = build_pipeline(src)
        state["pipe"] = pipe
        b = pipe.get_bus()
        b.add_signal_watch()
        b.connect("message::error", lambda _b, m: (log(f"error: {m.parse_error()[0].message}"), loop.quit()))
        b.connect("message::eos", lambda *_: loop.quit())
        if os.environ.get("LIVINGROOM_SHARE_DEBUG"):
            # frames per second actually delivered by the screen capture
            cnt = {"n": 0}
            pipe.get_by_name("cap").get_static_pad("src").add_probe(
                Gst.PadProbeType.BUFFER, lambda *_: (cnt.__setitem__("n", cnt["n"] + 1), Gst.PadProbeReturn.OK)[1])
            GLib.timeout_add_seconds(1, lambda: (log(f"capture frames/s: {cnt['n']}"), cnt.__setitem__("n", 0), True)[2])
        pipe.set_state(Gst.State.PLAYING)
        if state.get("notified"):
            return
        state["notified"] = True
        notify(("Living room is now an extra monitor" if EXTEND else "Sharing to the living room")
               + " — run it again to stop")

    def ready(fd, node):
        if not EXTEND:
            stream(f"fd={fd} path={node}")
            return
        # The portal stream creates the virtual monitor; its size is whatever
        # its consumer asks for (the living-room display's resolution). Its
        # own frames are discarded (see MonitorRecording).
        before = virtual_monitors()
        keep = Gst.parse_launch(f"pipewiresrc fd={fd} path={node} "
                                f"! video/x-raw,width={WIDTH},height={HEIGHT} "
                                f"! fakesink sync=false")
        state["keep"] = keep
        keep.set_state(Gst.State.PLAYING)

        def found(connector):
            log(f"extra monitor is {connector}")
            state["rec"] = MonitorRecording(connector, lambda n: stream(f"path={n}"), closed)

        def closed(rec):
            if state.get("rec") is not rec:
                return
            log("GNOME ended the recording (display layout changed); restarting it")
            if "pipe" in state:
                state.pop("pipe").set_state(Gst.State.NULL)
            del state["rec"]

            def again():
                if rec.connector in virtual_monitors():
                    found(rec.connector)
                else:
                    log("the extra monitor is gone")
                    loop.quit()
                return False
            GLib.timeout_add(1000, again)
        GLib.timeout_add(500, place_virtual_monitor, before, found)

    cast = ScreenCast(bus, ready)
    for s in (signal.SIGINT, signal.SIGTERM):
        signal.signal(s, lambda *_: GLib.idle_add(loop.quit))
    cast.start()
    try:
        loop.run()
    finally:
        for k in ("pipe", "keep"):
            if k in state:
                state[k].set_state(Gst.State.NULL)
        if "rec" in state:
            state["rec"].stop()
        cast.close()
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
        log("stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
