From d6585319f343ea57a9449fc91f45660ffd898949 Mon Sep 17 00:00:00 2001
From: build <build@local>
Date: Wed, 30 Sep 2026 12:56:22 +0530
Subject: [PATCH 29/32] ASoC: cht_yogabook: port to 7.2 DAPM API, use strscpy

---
 sound/soc/intel/boards/cht_yogabook.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/sound/soc/intel/boards/cht_yogabook.c b/sound/soc/intel/boards/cht_yogabook.c
index d2ce8cbbc..5eb3cc23e 100644
--- a/sound/soc/intel/boards/cht_yogabook.c
+++ b/sound/soc/intel/boards/cht_yogabook.c
@@ -24,6 +24,7 @@
 #include <linux/i2c.h>
 #include <linux/input.h>
 #include <linux/module.h>
+#include <linux/string.h>
 #include <linux/platform_device.h>
 #include <linux/slab.h>
 #include <linux/clk.h>
@@ -57,7 +58,7 @@ static int platform_clock_control(struct snd_soc_dapm_widget *w,
 		struct snd_kcontrol *k, int  event)
 {
 	struct snd_soc_dapm_context *dapm = w->dapm;
-	struct snd_soc_card *card = dapm->card;
+	struct snd_soc_card *card = snd_soc_dapm_to_card(dapm);
 	struct snd_soc_dai *codec_dai;
 	struct cht_mc_private *ctx = snd_soc_card_get_drvdata(card);
 	int ret;
@@ -114,7 +115,7 @@ static int cht_yb_hp_event(struct snd_soc_dapm_widget *w,
 		struct snd_kcontrol *k, int event)
 {
 	struct snd_soc_dapm_context *dapm = w->dapm;
-	struct snd_soc_card *card = dapm->card;
+	struct snd_soc_card *card = snd_soc_dapm_to_card(dapm);
 	struct cht_mc_private *ctx = snd_soc_card_get_drvdata(card);
 
 	dev_dbg(card->dev, "HP event: %s\n",
@@ -135,7 +136,7 @@ static int cht_yb_spk_event(struct snd_soc_dapm_widget *w,
 		struct snd_kcontrol *k, int event)
 {
 	struct snd_soc_dapm_context *dapm = w->dapm;
-	struct snd_soc_card *card = dapm->card;
+	struct snd_soc_card *card = snd_soc_dapm_to_card(dapm);
 	struct cht_mc_private *ctx = snd_soc_card_get_drvdata(card);
 
 	dev_dbg(card->dev, "SPK event: %s\n",
@@ -251,7 +252,7 @@ static int cht_yb_jack_event(struct notifier_block *nb,
 		unsigned long event, void *data)
 {
 	struct snd_soc_jack *jack = (struct snd_soc_jack *)data;
-	struct snd_soc_dapm_context *dapm = &jack->card->dapm;
+	struct snd_soc_dapm_context *dapm = snd_soc_card_to_dapm(jack->card);
 
 	if (event & SND_JACK_MICROPHONE) {
 		snd_soc_dapm_force_enable_pin(dapm, "MICBIAS1");
@@ -489,7 +490,7 @@ static void cht_codec_register_spidev(void)
 	int ret;
 
 	memset(&rt5677_board_info, 0, sizeof(rt5677_board_info));
-	strncpy(rt5677_board_info.modalias, "rt5677", sizeof(rt5677_board_info.modalias));
+	strscpy(rt5677_board_info.modalias, "rt5677");
 	rt5677_board_info.irq = 0;
 	rt5677_board_info.bus_num = 1;
 	rt5677_board_info.chip_select = 0;
